# Copy to .env (or .env.local) and fill in. Never commit the real file.

# --- Real AI inspection (server-side only; never prefix with NEXT_PUBLIC_) ---
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4.1

# --- Optional: custom retread rejection criteria (JSON array). Defaults live in lib/ai/retreadCriteria.ts ---
# RETREAD_REJECTION_CRITERIA_JSON=[{"code":"RR001","name":"...","description":"...","required_visual_evidence":"...","severity":"CRITICAL"}]

# --- Optional: log image metadata (never image data or keys) when running a production build ---
# TYREVISION_DEBUG=1
